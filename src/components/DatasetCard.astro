---
/**
 * Ett dataset som kort: rubrik, beskrivning, interaktiv visualisering, anteckningar och källa.
 * Visualiseringen väljs efter datasettyp: tidsserie → Chart, regionalt → RegionMap, flöde → FlowSankey,
 * skattekalkylator → TaxSankey.
 */
import Chart from './Chart.tsx';
import RegionMap from './RegionMap.tsx';
import FlowSankey from './FlowSankey.tsx';
import TaxSankey from './TaxSankey.tsx';
import SourceNote from './SourceNote.astro';
import type { AnyDataset } from '../lib/types';

interface Props {
  dataset: AnyDataset;
  height?: number;
}
const { dataset, height } = Astro.props;
---

<article class="dataset card" id={dataset.id}>
  <header>
    <h2>{dataset.title}</h2>
    <p class="muted">
      {dataset.description}{' '}
      {dataset.kind === 'timeseries' && <span class="unit">Enhet: {dataset.unit.replace(/\.$/, '')}.</span>}
    </p>
  </header>
  {dataset.kind === 'timeseries' && <Chart client:visible dataset={dataset} height={height} />}
  {dataset.kind === 'regional' && <RegionMap client:visible dataset={dataset} />}
  {dataset.kind === 'flow' && <FlowSankey client:visible dataset={dataset} />}
  {dataset.kind === 'calculator' && <TaxSankey client:visible dataset={dataset} />}
  {
    dataset.notes.length > 0 && (
      <details class="notes">
        <summary>Om datan</summary>
        <ul>
          {dataset.notes.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
      </details>
    )
  }
  <SourceNote dataset={dataset} />
</article>

<style>
  .dataset {
    padding: 20px;
    margin-bottom: 24px;
  }
  .dataset header p {
    margin-bottom: 16px;
    max-width: 75ch;
  }
  .unit {
    white-space: nowrap;
  }
  .notes {
    margin-top: 16px;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
  .notes summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
  }
  .notes ul {
    margin: 8px 0 0;
    padding-left: 20px;
  }
  @media (max-width: 560px) {
    .dataset {
      padding: 16px 12px;
    }
  }
</style>
