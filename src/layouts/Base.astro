---
import '../styles/global.css';
import { categories } from '../data/categories';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Slug för aktiv kategori – markeras i kategoriraden. */
  activeCategory?: string;
}

const SITE_NAME = 'Sverige i siffror';
const { title, description = 'Utforska officiell svensk statistik – befolkning, klimat, utsläpp, energi, ekonomi och mer.', activeCategory } =
  Astro.props;
const fullTitle = title ? `${title} – ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline>
      // Sätt tema före första renderingen för att undvika blink. Valet sparas per besökare.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Hoppa till innehållet</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={url()}>
          <span class="brand__mark" aria-hidden="true"></span>
          {SITE_NAME}
        </a>
        <nav aria-label="Huvudmeny" class="site-nav">
          <a href={url()}>Kategorier</a>
          <a href={url('om/')}>Om datan</a>
          <button type="button" class="theme-toggle" aria-label="Växla mellan ljust och mörkt läge" title="Ljust/mörkt läge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </nav>
      </div>
      <nav aria-label="Kategorier" class="cat-strip">
        <div class="container cat-strip__inner">
          {
            categories.map((c) => (
              <a
                href={url(`${c.slug}/`)}
                aria-current={c.slug === activeCategory ? 'page' : undefined}
                class:list={[{ empty: c.datasets.length === 0 }]}
              >
                {c.name}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          <strong>{SITE_NAME}</strong> visar enbart data från officiella källor som SCB, SMHI, Svenska kraftnät och andra
          myndigheter. Varje diagram anger källa, tabell och när datan hämtades.
        </p>
        <p class="muted"><a href={url('om/')}>Om datan och källorna</a></p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
      // Scrolla aktiv kategori in i vyn i kategoriraden (mobil)
      document.querySelector('.cat-strip [aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    z-index: 10;
    background: var(--surface);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
  }
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 16px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand__mark {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: linear-gradient(180deg, #2a78d6 0 55%, #eda100 55% 100%);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .site-nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .site-nav a:hover {
    color: var(--text-primary);
    background: var(--surface-sunken);
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--text-primary);
    background: var(--surface-sunken);
  }
  .cat-strip {
    border-top: 1px solid var(--border);
    /* Tona ut högerkanten så att det syns att raden går att scrolla */
    mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
  }
  .cat-strip__inner {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-top: 6px;
    padding-bottom: 6px;
  }
  .cat-strip__inner::-webkit-scrollbar {
    display: none;
  }
  .cat-strip a {
    flex: none;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .cat-strip a.empty {
    color: var(--text-muted);
  }
  .cat-strip a:hover {
    background: var(--surface-sunken);
    color: var(--text-primary);
  }
  .cat-strip a[aria-current='page'] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-ink);
    font-weight: 600;
  }
  main {
    min-height: 60vh;
    padding: 32px 0 48px;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 24px 0 32px;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
  @media (max-width: 480px) {
    .brand {
      font-size: 0.95rem;
    }
    .site-nav a {
      padding: 6px 6px;
      font-size: 0.9rem;
    }
  }
</style>
