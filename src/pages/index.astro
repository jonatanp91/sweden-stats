---
import Base from '../layouts/Base.astro';
import CategoryCard from '../components/CategoryCard.astro';
import KeyFigure from '../components/KeyFigure.astro';
import { categories } from '../data/categories';

const active = categories.filter((c) => c.datasets.length > 0);
const planned = categories.filter((c) => c.datasets.length === 0);
---

<Base>
  <div class="container">
    <section class="hero">
      <h1>Sverige i siffror</h1>
      <p class="lead">
        Utforska officiell statistik om Sverige: befolkning, klimat, utsläpp, energi, ekonomi och mycket mer.
        All data hämtas direkt från myndigheter som SCB och SMHI, och varje diagram visar sin källa.
      </p>
    </section>

    <section aria-labelledby="kf-heading" class="section">
      <h2 id="kf-heading" class="visually-hidden">Nyckeltal</h2>
      <div class="kf-grid">
        <KeyFigure dataset="befolkning-folkmangd" series="folkmangd" label="Folkmängd" compare="previous" />
        <KeyFigure
          dataset="utslapp-vaxthusgaser-sektor"
          series="total"
          label="Växthusgasutsläpp"
          compare="1990"
          compareMode="percent"
          upIsGood={false}
        />
        <KeyFigure dataset="el-produktion-kraftslag" series="total" label="Elproduktion" compare="previous" />
        <KeyFigure
          dataset="klimat-temperatur-lund"
          series="glidande"
          label="Medeltemperatur i Lund, 10-årsmedel"
          compare="1900"
        />
        <KeyFigure dataset="skatter-statsskuld" series="statsskuld" label="Statsskulden" compare="year-ago" decimals={0} />
        <KeyFigure
          dataset="skatter-skuld-bnp"
          series="maastricht"
          label="Offentlig skuld (Maastricht)"
          compare="previous"
          decimals={1}
        />
        <KeyFigure
          dataset="skatter-kommunalskatt-riket"
          series="total"
          label="Genomsnittlig kommunalskatt"
          compare="previous"
          decimals={2}
        />
      </div>
    </section>

    <section aria-labelledby="cat-heading" class="section">
      <h2 id="cat-heading">Kategorier</h2>
      <div class="cat-grid">
        {active.map((c) => <CategoryCard category={c} />)}
      </div>
    </section>

    <section aria-labelledby="planned-heading" class="section">
      <h2 id="planned-heading">På gång</h2>
      <p class="muted">Kategorier som planeras. Klicka för att se vilka källor och visualiseringar som är tänkta.</p>
      <div class="cat-grid">
        {planned.map((c) => <CategoryCard category={c} />)}
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    margin-bottom: 32px;
  }
  .section {
    margin-bottom: 40px;
  }
  .kf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 16px;
  }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  @media (max-width: 560px) {
    .kf-grid {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
  }
  @media (max-width: 380px) {
    .kf-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
